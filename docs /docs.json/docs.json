            ]
          },
          {
            "group": "Приём платежей",
            "icon": "credit-card",
            "pages": []
          },
          {
            "group": "Выплаты и массовые операции",
            "icon": "money-bill-transfer",
            "pages": []
          },
          {
            "group": "Вебхуки",
            "icon": "bolt",
            "pages": []
          },
          {
            "group": "Прод и надёжность",
            "icon": "shield-check",
            "pages": []
          }
        ]
      },
      {
        "tab": "Справочник",
        "icon": "code"
      },
      {
        "tab": "Модули CMS",
        "icon": "cart-shopping"
      },
      {
        "tab": "SDK",
        "icon": "cubes"
      }
    ]
