          "icon": "github",
          "href": "https://github.com/oblodai"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Инструкции",
        "icon": "book-open",
        "groups": [
          {
            "group": "Начало работы",
            "icon": "rocket",
            "pages": [
